# מספרי הטלפון של המנהלים (אתה), מופרדים בפסיק. בפורמט בינלאומי או 05X
OWNER_PHONES=972501234567

# אופציונלי: חיבור עם קוד צימוד במקום QR. מספר הטלפון של הבוט עצמו
PAIRING_PHONE=

# פורט לדף הסטטוס / QR
PORT=3000
# סיסמה לדף ה-QR. אם ריק - תיווצר אוטומטית ותודפס בלוג
WEB_TOKEN=

# השהייה בין שליחות לקבוצות (שניות) - מגן מפני חסימה
SEND_DELAY_MIN=3
SEND_DELAY_MAX=7

# גודל קובץ מקסימלי (MB)
MAX_FILE_MB=100

# תיקיית נתונים (חיבור, מסד נתונים, קבצים)
DATA_DIR=./data

LOG_LEVEL=info
