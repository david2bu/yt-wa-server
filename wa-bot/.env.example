# ===== חובה =====
# הכתובת של האתר (הדומיין שלך), בלי https://
DOMAIN=bot.example.com
# סיסמה לכניסה לאתר. כדאי סיסמה ארוכה
ADMIN_PASSWORD=
# המספר שלך, לקבלת התראות על פניות חדשות. בפורמט 05X או בינלאומי
OWNER_PHONES=0501234567

# ===== אופציונלי =====
# חיבור עם קוד צימוד במקום QR: מספר הטלפון של הבוט עצמו
PAIRING_PHONE=
# אזור זמן לתזמונים
TZ=Asia/Jerusalem
# השהייה אקראית בין שליחות לקבוצות (שניות). מגינה מפני חסימה
SEND_DELAY_MIN=3
SEND_DELAY_MAX=7
# הודעות שלקוח שולח ברצף בתוך כמה שניות נחשבות פרסום אחד (תמונה + טקסט)
GROUP_WINDOW_SECONDS=20
# כמה דקות לפחות לפני משבצת אפשר עוד לשבץ אליה אוטומטית
LEAD_MINUTES=2
# אחרי כמה ימים פרסומים שנשלחו (והקבצים שלהם) נמחקים
RETENTION_DAYS=60
MAX_FILE_MB=100
LOG_LEVEL=info
